# Supply-chain hardening (npm >= 11.10; older npm ignores these keys).
# Resolve only versions published at least 7 days ago, matching the Dependabot cooldown.
min-release-age=7
# Never fetch dependencies from git references.
allow-git=none
# Only the root package.json may name a tarball URL: SheetJS publishes fixed xlsx
# releases on cdn.sheetjs.com, not on npm. The lockfile pins its integrity hash.
allow-remote=root
